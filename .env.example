# SkillHub Docker 环境变量配置
# 复制此文件为 .env 并修改配置

# ==================== 必填配置 ====================

# JWT 密钥（必须修改为随机字符串，用于用户认证）
JWT_SECRET=your-random-secret-key-change-this

# MySQL 数据库密码
MYSQL_PASSWORD=skillhub_password

# MySQL root 密码
MYSQL_ROOT_PASSWORD=root_password

# ==================== 可选配置 ====================

# 服务端口（默认 80）
PORT=80

# AI 配置（可选，用于自动生成 Skill）
AI_API_KEY=
AI_API_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o
